# ==============================================================================
# Code Buddy 2.0 Backend Environment Configuration Example
# Copy to backend/.env for local setup or supply via deployment environment.
# NEVER commit real secrets, database credentials, or JWT keys.
# ==============================================================================

# --- Runtime Environment ---
# Use 'production' in live deployments; 'development' locally.
NODE_ENV=development

# HTTP listener port (must be 1-65535)
PORT=5000

# --- Database (Required) ---
# MongoDB Atlas / MongoDB connection URI
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# --- Authentication & Security (Required) ---
# Strong random secret (>= 32 characters enforced in production)
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars-long
# Optional JWT expiration window (default: 7d)
JWT_EXPIRES_IN=7d

# --- Google OAuth Student Authentication (Conditionally Required) ---
# Required for POST /api/auth/google. Omit only if running intentionally without Google login.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- CORS Allowlist (Required in Production) ---
# Comma-separated list of allowed frontend browser origins (no wildcards '*', no trailing paths).
# Development defaults to local Vite/dev localhost ports when unset.
# Example production: https://codebuddy.vvce.ac.in,https://admin.codebuddy.vvce.ac.in
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Reverse Proxy Trust (Deployment-Dependent, Default Disabled) ---
# Leave empty or 'false' when not behind a reverse proxy.
# Set to hop count (e.g. '1' behind a single Render/Railway/Nginx/Cloudflare proxy),
# safe preset ('loopback', 'linklocal', 'uniquelocal'), or comma-separated trusted proxy IPs.
# Never set to 'true' (permissive proxy trust allows IP rate-limit spoofing).
TRUST_PROXY=false

# --- Request Body Limits ---
# Maximum JSON payload size (bounded between 1kb and 5mb; default: 256kb)
JSON_BODY_LIMIT=256kb

# --- Rate Limiting (Tuned for Shared College Wi-Fi / Campus NAT) ---
# General /api window and limit per client IP (default: 2000 reqs / 15 min; /api/health exempt)
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=2000

# Staff credential login failed-attempt window and limits (successful logins are skipped)
LOGIN_RATE_LIMIT_WINDOW_MS=900000
# Per IP + hashed account identifier (default: 10 failed attempts / 15 min)
LOGIN_RATE_LIMIT_MAX=10
# Per IP burst cap across arbitrary usernames (default: 60 failed attempts / 15 min)
LOGIN_IP_RATE_LIMIT_MAX=60

# Google OAuth sign-in endpoint window and limit per IP (default: 300 reqs / 15 min)
GOOGLE_AUTH_RATE_LIMIT_WINDOW_MS=900000
GOOGLE_AUTH_RATE_LIMIT_MAX=300

# --- Admin Seed Script Only (scripts/seedAdmin.js) ---
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-strong-seed-password
# ADMIN_NAME=System Administrator

